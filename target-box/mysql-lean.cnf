# 把 MySQL 的記憶體佔用壓到最小，讓 target-box 塞進 --memory=512m（交付文件 §8：每個容器
# 一律 --cpus=0.5 --memory=512m）。campus_db 是個很小的資料庫，MySQL 8 的預設值
# （performance_schema、128M buffer pool、151 條連線各自保留 buffer）對它嚴重過剩 ——
# 未調時 mysqld 單獨就吃 ~513MB，超過整個上限。
#
# 放在 mysql.conf.d/ 且檔名 zz- 開頭，確保載入順序在發行版預設的 mysqld.cnf 之後、覆寫得掉。
[mysqld]
# 最大的一項：performance_schema 會依 max_connections／table cache 自動配置，動輒上百 MB。
# 演練用不到它，直接關掉。
performance_schema           = OFF

# InnoDB：小 DB 不需要 128M 的 buffer pool。
innodb_buffer_pool_size      = 32M
innodb_buffer_pool_instances = 1
innodb_log_buffer_size       = 4M

# MySQL 8 的 temptable 引擎預設可用到 1G RAM，壓到合理值。
temptable_max_ram            = 48M

# 連線數與各種 per-connection / 快取 buffer：對 3 個 Node 服務＋grader＋checker 足夠。
max_connections              = 60
table_open_cache             = 128
table_definition_cache       = 128
thread_cache_size            = 8
host_cache_size              = 0
tmp_table_size               = 8M
max_heap_table_size          = 8M
sort_buffer_size             = 256K
read_buffer_size             = 128K
read_rnd_buffer_size         = 256K
join_buffer_size             = 256K
key_buffer_size              = 8M
